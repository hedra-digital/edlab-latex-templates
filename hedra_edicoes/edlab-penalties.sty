% ===========================================================================
% edlab-penalties.sty
% ---------------------------------------------------------------------------
% Calibração de penalidades, demerits e parâmetros de quebra de linha e página
% para composição de livros em português brasileiro, Minion Pro 11pt, medida
% de 22 paicas, entrelinha 13.6pt (setSingleSpace 1.03).
%
% Princípios de calibração:
%   - PT-BR tem palavras longas; hifenação é inevitável e aceitável, em
%     medida frequente (1-3 consecutivas). Escadas longas (4+) são
%     desencorajadas pelo acúmulo de demerits, sem bloqueio absoluto.
%   - Prioridade à uniformidade de espaçamento inter-palavras. Linhas muito
%     esticadas ou muito apertadas são visualmente pior que hífens moderados.
%   - Minion Pro + microtype (protrusion + expansion) já refinam a mancha;
%     parâmetros TeX devem complementar sem contradizer.
%   - Notas de rodapé em [para] (corridas) pedem \interfootnotelinepenalty
%     alta para evitar quebras feias dentro da nota.
% ===========================================================================


% ---------------------------------------------------------------------------
% 1. Penalidades de linha (quebra horizontal, dentro do parágrafo)
% ---------------------------------------------------------------------------

% Custo de adicionar uma linha ao parágrafo. Baixo dá liberdade para o TeX
% ajustar o número total de linhas e achar a melhor solução global.
\linepenalty=10

% Custo de quebrar em hífen automático (babel). Default TeX = 50; 100 é
% levemente desencorajador sem tornar a hifenação proibitiva. Hifenar
% é aceitável em PT-BR e preferível a linhas com espaçamento ruim.
\hyphenpenalty=100

% Custo de quebrar em hífen explícito ("vir-a-ser", "pós-guerra"). Igual
% ao automático; ambos são tratados com mesma severidade moderada.
\exhyphenpenalty=100

% Matemática: penalidade em operador binário e em relação.
\binoppenalty=700
\relpenalty=500


% ---------------------------------------------------------------------------
% 2. Penalidades de página (quebra vertical)
% ---------------------------------------------------------------------------

% Órfã: última linha de parágrafo sozinha no topo da página. Proibitivo.
\widowpenalty=10000

% Viúva: primeira linha de parágrafo sozinha no pé da página. 150 é
% permissivo; o controle principal está em \clubpenalties abaixo.
\clubpenalty=150

% Órfã antes de display-math.
\displaywidowpenalty=50

% Linha hifenada no pé da página obriga o leitor a virar página para
% completar a palavra. Valor alto evita, sem proibir.
\brokenpenalty=500

% Penalidade de quebra antes/depois de display-math.
\predisplaypenalty=10000
\postdisplaypenalty=0

% Penalidade para dividir flutuantes.
\floatingpenalty=20000

% Entre linhas dentro de nota de rodapé. Crítico para notas em [para]
% (corridas): evita quebras feias no meio da nota.
\interfootnotelinepenalty=1000

% Fronteira de listas/verse: o LaTeX insere \@endparpenalty = -51 (bônus
% de quebra). Com \raggedbottom, badness é 0 em toda parte, e esse -51
% vence qualquer ponto interno de parágrafo — a quebra "gruda" após o
% verso e empurra o parágrafo-continuação inteiro para a página seguinte.
% Zerando, o empate em 0 faz o TeX preencher a página normalmente.
\@beginparpenalty=\z@
\@endparpenalty=\z@


% ---------------------------------------------------------------------------
% 3. Penalidades estendidas (e-TeX) — refinamentos por posição
% ---------------------------------------------------------------------------

% ATENÇÃO à semântica dos arrays (manual do e-TeX): o ÚLTIMO valor se
% repete para todas as linhas seguintes. Cada array precisa terminar em 0,
% senão a penalidade da última posição vale para o miolo inteiro do
% parágrafo e proíbe, na prática, qualquer quebra de página interna.
% (\interlinepenalties não é usado: como o \parshape, é zerado a cada
% \par, então não tem efeito quando setado no preâmbulo.)

% Controle fino de viúvas (primeiras linhas no pé da página):
%   - 1ª linha sozinha: 10000 (proibitivo)
%   - 2ª linha sozinha: 10000 (proibitivo)
%   - 3ª linha sozinha: 1000 (tolerado mas evitado)
%   - da 4ª em diante:  0
\clubpenalties=4 10000 10000 1000 0

% Controle fino de órfãs (últimas linhas no topo da página):
%   - última sozinha: 10000 (proibitivo)
%   - duas últimas:   9000
%   - três últimas:   6000
%   - antes disso:    0
\widowpenalties=4 10000 9000 6000 0

% Órfãs antes de display-math.
\displaywidowpenalties=3 8000 5000 0


% ---------------------------------------------------------------------------
% 4. Demerits — ponderação de soluções globais do parágrafo
% ---------------------------------------------------------------------------
%
% Demerits são somados à badness ao quadrado de cada linha. O TeX escolhe
% a solução que minimiza o total. Valores moderados aqui permitem hífens
% mas desencorajam escadas longas por acúmulo natural.

% Custo por par consecutivo de linhas hifenadas.
% 25000 é o valor clássico do plain TeX, calibrado para permitir pares
% isolados sem gerar escadas longas. Com acúmulo quadrático (numa
% sequência de N hífens consecutivos, somam-se N-1 penalidades), 4+
% consecutivos ficam caros o suficiente para o TeX procurar alternativas.
\doublehyphendemerits=25000

% Custo extra se a penúltima linha terminar em hífen. Hifenar na penúltima
% quase sempre resulta em última linha curta (runt).
\finalhyphendemerits=50000

% Custo por par de linhas "incompatíveis" (uma apertada ao lado de uma
% esticada). Subido ligeiramente acima do default LaTeX (10000) para
% favorecer uniformidade de espaçamento entre linhas vizinhas.
\adjdemerits=15000


% ---------------------------------------------------------------------------
% 5. Parâmetros de justificação e hifenação
% ---------------------------------------------------------------------------

% Tolerância de badness por linha. 400 é valor clássico para prosa
% justificada: exige linhas uniformes, aceita hifenação como trade-off.
% Valor mais alto (>500) permite linhas visualmente esticadas.
\tolerance=400

% Folga adicional para passagens difíceis (segunda passagem do algoritmo).
% 1.5pc é suficiente para resolver parágrafos com vocabulário denso sem
% produzir linhas visualmente esticadas. 3pc+ permite "gás" inaceitável.
\emergencystretch=1.5pc

% Mínimo de letras antes/depois do hífen. Norma editorial PT-BR: 3+3.
\lefthyphenmin=3
\righthyphenmin=3


% ---------------------------------------------------------------------------
% 6. Equilíbrio vertical da página
% ---------------------------------------------------------------------------

% \raggedbottom permite que páginas terminem em alturas diferentes, em vez
% de esticar espaços verticais para preencher. Escolha segura com notas
% de rodapé frequentes. Alternativa: \flushbottom.
\raggedbottom
