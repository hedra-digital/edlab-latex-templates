% Comando para fazer subtítulo
\newcommand{\subtitulo}[1]{\NoCaseChange{\textnormal{\break\Large\itshape#1}}}
% \chapterspecial{Título}{Subtítulo} — capítulo numerado, entra no sumário com número.
% \chapterspecial*{Título}{Subtítulo} — capítulo SEM número: não gasta o contador,
%   não imprime «Capítulo N» na abertura e entra no sumário sem numeral, mas mantém
%   o cabeço e o reset das notas de rodapé, como qualquer capítulo.
%
% A estrela serve ao paratexto que abre o volume (apresentação, nota da edição,
% introdução de terceiro), que não é capítulo da obra: contado, empurra a
% numeração dos capítulos do autor. Nasceu no «Diário de um escritor» em
% 14/9/2026, onde a Apresentação e a Introdução viravam capítulos 1 e 2, e veio ao
% template em 8/10/2026.
\newcommand{\chapterspecial}{\@ifstar\edlab@chapterspecialsn\edlab@chapterspecialnum}
\newcommand{\edlab@chapterspecialnum}[2]{%
 \chapter[#1]%
     {#1\ifx#2\relax\else\subtitulo{#2}\fi}%
\markright{#1}}
% A forma estrelada aceita, desde 17/9/2026, um argumento OPCIONAL com a
% entrada do sumário, para quando ela precisa dizer mais que o título:
%   \chapterspecial*[Apresentação, \textit{por Irineu Franco Perpetuo}]{Apresentação}{}
% Sem ele, nada muda — a entrada continua sendo o próprio título.
% ⚠️ Existe porque a macro JÁ grava a sua entrada: acrescentar um
% \addcontentsline à mão logo depois dela não substitui a dela, soma-se, e o
% sumário sai com o item repetido.
% O cabeço segue o título, nunca a entrada longa.
\newcommand{\edlab@chapterspecialsn}[3][]{%
 \chapter*{#2\ifx#3\relax\else\subtitulo{#3}\fi}%
 \def\edlab@tocsn{#1}%
 \ifx\edlab@tocsn\@empty
   \addcontentsline{toc}{chapter}{#2}%
 \else
   \addcontentsline{toc}{chapter}{#1}%
 \fi
\markright{#2}}

